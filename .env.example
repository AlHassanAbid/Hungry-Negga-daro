# ------------------------------------------------------------------
# Environment configuration — copy to `.env` for local development.
# NEVER commit the real `.env` file. The `.env` and `.env.*` patterns
# are git-ignored; only this `.env.example` is tracked.
# ------------------------------------------------------------------

# --- Contact form (Resend) ---
# API key for sending portfolio contact messages.
# Get one at https://resend.com
RESEND_API_KEY=

# Who should receive contact form messages (default: hello@alhassanabid.dev)
CONTACT_TO_EMAIL=

# Verified "from" address allowed by Resend (default: Portfolio <onboarding@resend.dev>)
CONTACT_FROM_EMAIL=

# --- Admin panel (optional) ---
# Enable the /admin area by setting BOTH values:
#  1. ADMIN_PANEL_PASSWORD : the password you type on the login page.
#  2. ADMIN_SESSION_PASSWORD : secret used to encrypt the admin session
#     cookie. Use a random string of at least 32 characters
#     (e.g. `openssl rand -base64 48`). If you change it, all sessions
#     are invalidated.
# If either is empty, /admin is locked down entirely.
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_PASSWORD=